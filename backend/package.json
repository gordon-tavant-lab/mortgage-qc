{
  "name": "mortgage-qc-backend",
  "private": true,
  "version": "0.0.0",
  "description": "Touchless API proxy (spec 020) — server-side only, never bundled by Vite. Stateless per-request except a short-lived in-memory OAuth token cache.",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "audit": "npm audit --audit-level=high",
    "verify:no-leaks": "bash scripts/verify-no-leaks.sh",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}

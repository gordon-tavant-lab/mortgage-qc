# Touchless API proxy — environment configuration (spec 020)
# Copy this file to `.env` (gitignored, never committed) and fill in real values for local/demo runs.

# OAuth client credentials for the Touchless QA gateway (client_credentials grant).
TOUCHLESS_CLIENT_ID=<set-me>
TOUCHLESS_CLIENT_SECRET=<set-me>

# Fixed, server-configured base host for all outbound Touchless calls — never
# client-influenced (SSRF guard, see plan.md §2.6 / security-review.md §2).
TOUCHLESS_BASE_URL=https://qa-touchless.tavant.com

# Port this Express proxy listens on in dev (frontend's vite.config.ts proxies
# /api to this port — see plan.md §3).
PORT=4000

# Outbound request timeout (ms) for calls to the Touchless gateway before the
# proxy returns a TIMEOUT error envelope (plan.md §2.5).
REQUEST_TIMEOUT_MS=10000

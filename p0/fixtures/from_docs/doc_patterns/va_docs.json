{
  "filename_contains": [
    "VA_Notice_of_Value",
    "VA_Appraisal",
    "VA_Certificate_of_Eligibility"
  ],
  "fields": {
    "notice_of_value_date": {
      "regex": "NOV Issue Date\\s+(\\d{2}/\\d{2}/\\d{4})"
    },
    "termite_inspection_present": {
      "regex": "(Not present in file)",
      "boolean_false_if_found": true
    },
    "va_coe_basic_entitlement": {
      "regex": "Basic Entitlement Available\\s+\\$?([\\d,]+\\.?\\d*)",
      "normalize": "decimal"
    },
    "va_coe_bonus_entitlement": {
      "regex": "Bonus Entitlement Available\\s+\\$?([\\d,]+\\.?\\d*)",
      "normalize": "decimal"
    },
    "va_appraised_value": {
      "regex": "Appraised Value\\s+\\$?([\\d,]+\\.?\\d*)",
      "normalize": "decimal"
    },
    "property_value": {
      "regex": "Appraised Value\\s+\\$?([\\d,]+\\.?\\d*)",
      "normalize": "decimal"
    },
    "va_appraiser_name": {
      "regex": "Appraiser\\s+([^\\n*]+)"
    },
    "veteran_name": {
      "regex": "Veteran Name\\s+([^\\n*]+)"
    },
    "va_service_number": {
      "regex": "Service Number\\s+(\\S+)"
    },
    "va_branch_of_service": {
      "regex": "Branch of Service\\s+([^\\n*]+)"
    },
    "va_entitlement_code": {
      "regex": "Entitlement Code\\s+(\\S+)"
    },
    "va_funding_fee_status": {
      "regex": "Funding Fee Status\\s+([^\\n*]+)"
    },
    "va_coe_issue_date": {
      "regex": "COE Issue Date\\s+(\\d{2}/\\d{2}/\\d{4})"
    },
    "va_lgy_case_number": {
      "regex": "LGY Case Number\\s+(\\S+)"
    },
    "va_notice_of_reasonable_value": {
      "regex": "Notice of Reasonable Value\\s+\\$?([\\d,]+\\.?\\d*)",
      "normalize": "decimal"
    },
    "va_nov_validity_period": {
      "regex": "NOV Validity Period\\s+([^\\n*]+)"
    },
    "va_sar_signature": {
      "regex": "SAR Signature\\s+([^\\n*]+)"
    },
    "year_built_appraisal": {
      "regex": "Year Built\\s+(\\d{4})"
    }
  }
}

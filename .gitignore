# Real client rule workbooks + loan documents — large, may carry PII, kept on disk not in git.
# demo/syn (synthetic test fixtures) and demo/rules (AMQ rule workbooks) are tracked;
# everything else under demo/ (real loan PDFs/XML in numeric loan-number directories,
# e.g. demo/301224293/) stays untracked — real borrower PII, kept on disk only.
demo/*
!demo/syn/
!demo/rules/
/src/
tmp/

# Reference example apps (the AI Studio prototype + Gordon's separate "Mortgage QC
# Platform" repo) — kept on disk for reference only, never part of this repo's history
examples/

# Real-loan local cache (012-real-loan-distribution-eval) — real borrower PII must
# never be git-tracked; loans live in S3 only (see specs/012-real-loan-distribution-eval)
p0/eval_real/local_cache/

# Claude Code / Gordon-OS session artifacts (tool-internal, not product files)
.claude/agent-memory/
output/.claude/
p0/.claude/
**/.pytest_cache/
__pycache__/
*.pyc

# Python virtual envs / Node deps (none in use at repo root today; excluded defensively)
.venv/
venv/
node_modules/
dist/

# Env files / credentials — never committed
.env
.env.*
*.pem
*.key
*credentials*

# Exception: .env.example files are committed templates (placeholder values only,
# e.g. backend/.env.example for spec 020) — the .env.* pattern above would otherwise
# also match and hide these from git.
!.env.example
!**/.env.example

# Postman environment exports carry live secrets by construction (e.g.
# docs/architecture/api/TLP-QA-QC-Creds.postman_environment held a cleartext
# client_secret, untracked but NOT matched by *credentials* — "Creds" != "credentials").
# Broader, durable guard found during spec 020 security review (2026-08-01).
*.postman_environment

# Gordon-OS workspace bootstrap templates (auto-regenerate via SessionStart hook)
PORTFOLIO.md
goal-weights.yaml

# Stray file unrelated to this project (belongs to a different Tavant repo, dropped
# here by accident)
/sales-agent.zip

.DS_Store

# Office lock/temp files
~$*

# claude-loop tool-internal session artifacts (not product files)
.claude-loop-runs/
.claude-loop-criteria.md

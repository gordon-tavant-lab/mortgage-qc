# ========================================
# LTV Threshold Shapes (Program-Specific)
# ========================================

# CONVENTIONAL LTV: 97% (FICO >= 740) or 95% (FICO < 740)
tl:LtvConventionalHighFicoShape
    a sh:NodeShape ;
    sh:targetClass tl:LoanApplication ;
    sh:condition [
        sh:path tl:mortgageType ;
        sh:hasValue "CONVENTIONAL"
    ] ;
    sh:condition [
        sh:path tl:fico ;
        sh:minInclusive 740.0
    ] ;
    sh:property [
        sh:path tl:ltv ;
        sh:maxInclusive 97.0 ;
        sh:message "LTV {$this}% exceeds CONVENTIONAL limit 97% (FICO >= 740)" ;
        sh:severity sh:Violation
    ] .

tl:LtvConventionalLowFicoShape
    a sh:NodeShape ;
    sh:targetClass tl:LoanApplication ;
    sh:condition [
        sh:path tl:mortgageType ;
        sh:hasValue "CONVENTIONAL"
    ] ;
    sh:condition [
        sh:path tl:fico ;
        sh:maxExclusive 740.0
    ] ;
    sh:property [
        sh:path tl:ltv ;
        sh:maxInclusive 95.0 ;
        sh:message "LTV {$this}% exceeds CONVENTIONAL limit 95% (FICO < 740)" ;
        sh:severity sh:Violation
    ] .

# FHA LTV: 96.5%
tl:LtvFhaShape
    a sh:NodeShape ;
    sh:targetClass tl:LoanApplication ;
    sh:condition [
        sh:path tl:mortgageType ;
        sh:hasValue "FHA"
    ] ;
    sh:property [
        sh:path tl:ltv ;
        sh:maxInclusive 96.5 ;
        sh:message "LTV {$this}% exceeds FHA limit 96.5%" ;
        sh:severity sh:Violation
    ] .

# VA LTV: 100%
tl:LtvVaShape
    a sh:NodeShape ;
    sh:targetClass tl:LoanApplication ;
    sh:condition [
        sh:path tl:mortgageType ;
        sh:hasValue "VA"
    ] ;
    sh:property [
        sh:path tl:ltv ;
        sh:maxInclusive 100.0 ;
        sh:message "LTV {$this}% exceeds VA limit 100%" ;
        sh:severity sh:Violation
    ] .

# USDA LTV: 100%
tl:LtvUsdaShape
    a sh:NodeShape ;
    sh:targetClass tl:LoanApplication ;
    sh:condition [
        sh:path tl:mortgageType ;
        sh:hasValue "USDA"
    ] ;
    sh:property [
        sh:path tl:ltv ;
        sh:maxInclusive 100.0 ;
        sh:message "LTV {$this}% exceeds USDA limit 100%" ;
        sh:severity sh:Violation
    ] .

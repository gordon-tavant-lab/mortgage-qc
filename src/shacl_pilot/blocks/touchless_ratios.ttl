@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tl: <http://touchless.audit/loan#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ========================================
# DTI Threshold Shapes (Program-Specific)
# ========================================

# CONVENTIONAL DTI: 45%
tl:DtiConventionalShape
    a sh:NodeShape ;
    sh:targetClass tl:LoanApplication ;
    sh:condition [
        sh:path tl:mortgageType ;
        sh:hasValue "CONVENTIONAL"
    ] ;
    sh:property [
        sh:path tl:totalDebtExpenseRatioPercent ;
        sh:maxInclusive 45.0 ;
        sh:message "DTI {$this}% exceeds CONVENTIONAL limit 45%" ;
        sh:severity sh:Violation
    ] .

# FHA DTI: 50%
tl:DtiFhaShape
    a sh:NodeShape ;
    sh:targetClass tl:LoanApplication ;
    sh:condition [
        sh:path tl:mortgageType ;
        sh:hasValue "FHA"
    ] ;
    sh:property [
        sh:path tl:totalDebtExpenseRatioPercent ;
        sh:maxInclusive 50.0 ;
        sh:message "DTI {$this}% exceeds FHA limit 50%" ;
        sh:severity sh:Violation
    ] .

# VA DTI: 41%
tl:DtiVaShape
    a sh:NodeShape ;
    sh:targetClass tl:LoanApplication ;
    sh:condition [
        sh:path tl:mortgageType ;
        sh:hasValue "VA"
    ] ;
    sh:property [
        sh:path tl:totalDebtExpenseRatioPercent ;
        sh:maxInclusive 41.0 ;
        sh:message "DTI {$this}% exceeds VA limit 41%" ;
        sh:severity sh:Violation
    ] .

# USDA DTI: 41%
tl:DtiUsdaShape
    a sh:NodeShape ;
    sh:targetClass tl:LoanApplication ;
    sh:condition [
        sh:path tl:mortgageType ;
        sh:hasValue "USDA"
    ] ;
    sh:property [
        sh:path tl:totalDebtExpenseRatioPercent ;
        sh:maxInclusive 41.0 ;
        sh:message "DTI {$this}% exceeds USDA limit 41%" ;
        sh:severity sh:Violation
    ] .


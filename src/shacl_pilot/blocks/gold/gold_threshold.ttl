### GoldThresh_0371_O_FNM_54327 -- threshold_eligibility -- PC::O-FNM-15420 / O-FNM-54327
# curation note: RefiNow DTI ratio cap (65%). RefiNow-program membership is not independently verified on this loan -- applied as a general DTI threshold; a false positive is possible on a non-RefiNow loan whose DTI happens to exceed 65%.
li:GoldThresh_0371_O_FNM_54327 a sh:NodeShape ;
    sh:targetClass li:LoanInstance ;
    caro:goldCardId "PC::O-FNM-15420" ; caro:goldExceptionCode "O-FNM-54327" ;
    caro:goldCheckType "threshold_eligibility" ; caro:blockRef "product_specific" ; caro:hasSeverity "Critical" ;
    caro:goldNote "RefiNow DTI ratio cap (65%). RefiNow-program membership is not independently verified on this loan -- applied as a general DTI threshold; a false positive is possible on a non-RefiNow loan whose DTI happens to exceed 65%." ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes li:PilotPrefixesGold ;
        sh:message "[PC::O-FNM-15420 / O-FNM-54327 / threshold_eligibility] The RefiNow DTI ratio exceeds 65%. (this loan's dti_ratio = ${?__val})" ;
        sh:select """SELECT $this ?__val WHERE {
            $this li:dti_ratio ?__val .
            FILTER(?__val > 65.0) }""" ] .


# Block: UNDERWRITING — AMQ "Underwriting" category checks
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix li:   <http://mortgage.audit.ontology/loan-instance#> .
@prefix caro: <http://mortgage.audit.ontology/caro#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

li:PilotPrefixes a owl:Ontology ;
    sh:declare [ sh:prefix "li" ;
                 sh:namespace "http://mortgage.audit.ontology/loan-instance#"^^xsd:anyURI ] ,
               [ sh:prefix "xsd" ;
                 sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] .

### CHK-UND-001 — VA residual income calculation documented
li:ResidualIncomeShape a sh:NodeShape ;
    sh:targetClass li:LoanInstance ;
    caro:checkId "CHK-UND-001" ; caro:blockRef "underwriting" ;
    caro:exceptionRef "VA-Residual-Income" ; caro:hasSeverity "Major" ;
    caro:citesFields "doc_present_residual_income_worksheet", "mismo_mortgage_type" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes li:PilotPrefixes ;
        sh:message "VA residual income calculation not documented in file." ;
        sh:select """SELECT $this WHERE {
            $this li:doc_present_residual_income_worksheet false ;
                  li:mismo_mortgage_type "VA" . }""" ] .

### CHK-UND-002 — USDA ratio waiver (PITI / DTI over guideline without waiver)
# Both guideline values are EXTRACTED from the loan's own ratio worksheet —
# no invented thresholds.
li:RatioWaiverShape a sh:NodeShape ;
    sh:targetClass li:LoanInstance ;
    caro:checkId "CHK-UND-002" ; caro:blockRef "underwriting" ;
    caro:exceptionRef "USDA-Ratio-Waiver" ; caro:hasSeverity "Major" ;
    caro:citesFields "piti_ratio", "piti_guideline", "dti_ratio", "dti_guideline", "usda_ratio_waiver_in_file" ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes li:PilotPrefixes ;
        sh:message "Ratios exceed guidelines (PITI {?piti}% > {?pg}%; DTI {?dti}% > {?dg}%) and no ratio waiver request / compensating factors are documented." ;
        sh:select """SELECT $this ?piti ?pg ?dti ?dg WHERE {
            $this li:piti_ratio ?piti ; li:piti_guideline ?pg ;
                  li:dti_ratio ?dti ; li:dti_guideline ?dg ;
                  li:usda_ratio_waiver_in_file false .
            FILTER (?piti > ?pg && ?dti > ?dg) }""" ] .
